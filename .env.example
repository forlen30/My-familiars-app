# คัดลอกไฟล์นี้เป็น .env สำหรับทดสอบในเครื่อง (ห้ามอัปโหลด .env ขึ้น GitHub)
# บนเว็บจริงให้ตั้งค่าเหล่านี้ใน Netlify → Site configuration → Environment variables

# --- ใช้ในหน้าเว็บ (ปลอดภัยที่จะเปิดเผย เพราะข้อมูลถูกป้องกันด้วย RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYMENTS_ENABLED=false

# --- ใช้เฉพาะฝั่ง server (Netlify Functions) ห้ามขึ้นต้นด้วย VITE_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYMENTS_ENABLED=false
PAYMENT_WEBHOOK_SECRET=
